# Copy this file to .env and fill in values for local development.
# Never commit .env with real credentials.

# Database — these values are used by both the service and the Postgres container in compose.
# For local dev only; never use these credentials in staging or production.
DB_URL=jdbc:postgresql://postgres:5432/payment_local
DB_USERNAME=payment
DB_PASSWORD=payment

# JWT / OAuth2 (point to your local IdP, e.g. Keycloak)
JWT_ISSUER_URI=http://localhost:8180/realms/payment-poc

# Server
PORT=8080

# Flyway (set to false to skip migrations on startup)
SPRING_FLYWAY_ENABLED=true
